# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Use the connection string from Supabase → Connect → Connection string.
# Supabase direct connections (db.<ref>.supabase.co) are IPv6-only on newer
# projects. If your network lacks IPv6, use the "Session pooler" string
# (port 5432) instead — it works for both the app and migrations.
# For serverless deployments, the "Transaction pooler" (port 6543) also works;
# the app already sets `prepare: false` for it.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate a secret with: npx auth@latest secret
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# "openai" (default) or "google"
AI_PROVIDER="openai"

# Optional: override the default model.
# OpenAI default: gpt-4o-mini
# Google default: gemini-2.5-flash
# AI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Google OAuth (optional)
# ---------------------------------------------------------------------------
# Web redirect flow (browser): create a Web OAuth client in Google Cloud Console.
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://your-production-domain/api/auth/callback/google
# You can use GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET, or the explicit web vars below.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_WEB_CLIENT_ID=""
# GOOGLE_WEB_CLIENT_SECRET=""
#
# Native Android sign-in (Capacitor, @capgo/capacitor-social-login + Better Auth ID token):
# - Create an Android OAuth client (package com.lumen.notes + SHA-1).
# - Expose the Google Web client ID to the client app for the plugin:
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# - Optionally set the Android client ID so Better Auth accepts its ID token audience:
# GOOGLE_ANDROID_CLIENT_ID=""
