# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Use the connection string from Supabase → Connect → Connection string.
# Supabase direct connections (db.<ref>.supabase.co) are IPv6-only on newer
# projects. If your network lacks IPv6, use the "Session pooler" string
# (port 5432) instead — it works for both the app and migrations.
# For serverless deployments, the "Transaction pooler" (port 6543) also works;
# the app already sets `prepare: false` for it.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate a secret with: npx auth@latest secret
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# "openai" (default) or "google"
AI_PROVIDER="openai"

# Optional: override the default model.
# OpenAI default: gpt-4o-mini
# Google default: gemini-2.5-flash
# AI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Google OAuth (optional)
# ---------------------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
